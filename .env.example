# AvatarLoom 环境变量样板
# 拷贝为 .env 并按需填写。所有 Key 都是可选——不填时使用 Mock 链路。
# 优先级：默认值 < YAML 配置 < .env < 环境变量 < CLI 参数。

# ===== 服务端口（进程监听的真实端口）=====
# 独立别名：control-api 认 AVATARLOOM_CONTROL_API_PORT，gateway 认 AVATARLOOM_RUNTIME_GATEWAY_PORT
# （都兼容旧名 AVATARLOOM_PORT）。STUDIO_PORT 供 start.sh 启动前端用。
#
# 注意：这是服务绑定端口。用户/浏览器访问走隧道映射（AutoDL 场景）：
#   studio 3000 → localhost:13000
#   control-api 8100 → localhost:18100
#   gateway 8101 → localhost:18101
# 本地 dev（make dev 三服务在本机）才直连 3000/8100/8101。
AVATARLOOM_CONTROL_API_PORT=8100
AVATARLOOM_RUNTIME_GATEWAY_PORT=8101
STUDIO_PORT=3000

# ===== 默认 Profile =====
# WS 客户端不带 profile_id 时 gateway 用的档位。默认 mock——无 GPU/无 Key 可跑通。
# 真实 GPU 部署改成 profiles/ 里的档位名（如 autodl-best），
# 或保持默认、由 Studio 前端按会话选择。
AVATARLOOM_DEFAULT_PROFILE=mock

# ===== 鉴权（可选，留空=关闭）=====
# 一套 token 同时保护 control-api HTTP 端点与 gateway /ws/realtime。
# 填值后：HTTP 需 Authorization: Bearer <token>；WS 浏览器首条消息自动发送 auth token，
# 脚本客户端使用 Authorization: Bearer <token>。不要把 token 放进 WS URL 查询参数。
# Docker Compose 会把它作为 NEXT_PUBLIC_WS_TOKEN 在 Studio 构建期内联（单用户隧道模型）。
# gateway 调 control-api 走 AVATARLOOM_CONTROL_API_TOKEN——本地同进程部署时与上面同值即可。
AVATARLOOM_API_TOKEN=
AVATARLOOM_CONTROL_API_TOKEN=

# ===== 存储 =====
AVATARLOOM_DB_URL=sqlite+aiosqlite:///./data/avatarloom.db
AVATARLOOM_ARTIFACTS_ROOT=./data/artifacts
AVATARLOOM_RUNS_ROOT=./data/runs

# ===== 日志 =====
AVATARLOOM_LOG_LEVEL=INFO

# ===== OpenAI-compatible LLM（真实 Adapter 用，留空走 Mock）=====
# 任何 OpenAI 兼容端点都行：OpenAI / DeepSeek / Moonshot / Ollama / vLLM …
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== OpenAI-compatible STT =====
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# ===== OpenAI-compatible TTS =====
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ===== Ollama（本地 LLM，可选）=====
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ===== Mac MLX 远程 TTS（Distributed Profile，可选）=====
MLX_TTS_ENDPOINT=

# ===== Avatar 远程服务（Distributed Profile，可选）=====
AVATAR_ENDPOINT=

# ===== Vision 多模态（可选，不填则禁用 Vision Block）=====
# MiniMax minimax-m3（OpenAI 兼容端点）：
#   VISION_BASE_URL=https://api.minimaxi.com/v1
#   VISION_MODEL=minimax-m3
# 其他 OpenAI 兼容多模态端点（GPT-4o / Qwen-VL …）改 baseUrl/model 即可。
# 注意 minimax-m3 是推理模型，输出含 <think> 段——Vision Block 已自动剥离。
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== 调试 =====
AVATARLOOM_DEBUG=0
