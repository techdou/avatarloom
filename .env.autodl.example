# AvatarLoom AutoDL 环境变量（DeepSeek LLM + 本地 GPU TTS/Avatar）
#
# 拷贝为 .env 后填入你的 DeepSeek API key。
# key 从 https://platform.deepseek.com/ -> API Keys 获取。

# ===== DeepSeek LLM =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=填这里你的_deepseek_key
LLM_MODEL=deepseek-chat

# ===== STT（本地 SenseVoice，GPU）=====
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# ===== TTS（本地 VoxCPM2，GPU）=====
# TTS_* 留空——本地 VoxCPM2 不需要 API
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

# ===== Vision 多模态（可选）=====
# MiniMax minimax-m3（OpenAI 兼容端点）：
#   VISION_BASE_URL=https://api.minimaxi.com/v1
#   VISION_MODEL=minimax-m3
# minimax-m3 是推理模型，输出含 <think> 段——Vision Block 已自动剥离。
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== Avatar（本地 MuseTalk，GPU）=====
AVATAR_ENDPOINT=

# ===== 服务端口 =====
# 独立别名：control-api 认 AVATARLOOM_CONTROL_API_PORT，gateway 认 AVATARLOOM_RUNTIME_GATEWAY_PORT
# （都兼容旧名 AVATARLOOM_PORT）。STUDIO_PORT 供 start.sh 启动前端用。
AVATARLOOM_CONTROL_API_PORT=27810
AVATARLOOM_RUNTIME_GATEWAY_PORT=27811
STUDIO_PORT=27300

# ===== 默认 Profile =====
# AutoDL GPU 部署显式锁定真实档位（gateway 全局默认是 mock，开发机用）。
AVATARLOOM_DEFAULT_PROFILE=autodl-best

# ===== 鉴权（可选，留空=关闭）=====
# 一套 token 同时保护 control-api HTTP 与 gateway /ws/realtime。
# AutoDL 实例对外暴露端口时建议填一个长随机串（隧道自用可留空）。
AVATARLOOM_API_TOKEN=
AVATARLOOM_CONTROL_API_TOKEN=

# ===== 存储 =====
AVATARLOOM_DB_URL=sqlite+aiosqlite:///./data/avatarloom.db
AVATARLOOM_ARTIFACTS_ROOT=/root/autodl-tmp/avatarloom/artifacts
AVATARLOOM_RUNS_ROOT=/root/autodl-tmp/avatarloom/runs

# ===== HuggingFace 镜像（国内加速）=====
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ===== 日志 =====
AVATARLOOM_LOG_LEVEL=INFO
