# AvatarLoom Studio (Next.js)
FROM node:20-slim AS base

WORKDIR /app

# 启用 pnpm——corepack 按根 package.json 的 packageManager 字段固定版本（pnpm@11.10.0），
# 不 prepare @latest，保证构建可复现。
RUN corepack enable

# 拷贝 workspace 配置与全部成员的 package.json（pnpm install 需要成员清单完整）。
# packages/ui 为空目录、已不在 workspace 内，无需拷贝。
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/studio/package.json ./apps/studio/
COPY packages/sdk-typescript/package.json ./packages/sdk-typescript/

# 严格按 lockfile 安装——失败立即报错，不做静默降级安装（依赖漂移是构建事故）。
RUN pnpm install --frozen-lockfile

# 拷贝源码
COPY . .

# 浏览器直连 Gateway 时，token 会在构建期内联进客户端 bundle。
# 这是共享密钥模型：仅适用于受控的单用户隧道；多用户部署应改用服务端会话 token。
# 注意：build arg 会留在镜像 history（docker history 可见），镜像不得公开分发。
ARG NEXT_PUBLIC_WS_TOKEN=

# 构建（build 期 ARG 已够 Next 内联，不设 ENV 避免进入镜像 config）
RUN pnpm --filter @avatarloom/studio build

ENV NODE_ENV=production
ENV PORT=3000

# 非 root 运行
RUN useradd -r -u 10001 app && chown -R app:app /app
USER app

EXPOSE 3000

CMD ["pnpm", "--filter", "@avatarloom/studio", "start"]
