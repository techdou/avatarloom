# AvatarLoom Control API
FROM python:3.11-slim AS base

WORKDIR /app

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ curl && rm -rf /var/lib/apt/lists/*

# 安装 uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 先拷贝依赖清单（利用 Docker 层缓存）
COPY pyproject.toml uv.lock* ./
COPY packages/ ./packages/
COPY apps/control-api ./apps/control-api

# 安装依赖（仅 control-api 需要的）
RUN uv sync --extra dev --no-dev 2>/dev/null || uv sync

# 拷贝源码
COPY . .

ENV AVATARLOOM_HOST=0.0.0.0
ENV AVATARLOOM_PORT=8100
ENV AVATARLOOM_DB_URL=sqlite+aiosqlite:///./data/avatarloom.db
EXPOSE 8100

CMD ["uv", "run", "python", "-m", "avatarloom_control_api"]
