# ============================================================
# AvatarLoom .gitignore
# 原则：密钥/私密信息不泄漏、开发配置目录不上传、文档不入库。
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.eggs/
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.nox/
.uv-cache/
.coverage
.coverage.*
htmlcov/
.tox/
junit.xml

# ---- Node / Next.js ----
node_modules/
.pnpm-store/
.next/
out/
.turbo/
.vercel/
storybook-static/
.nyc_output/
playwright-report/
test-results/
blob-report/
*.tsbuildinfo
.eslintcache
.stylelintcache
next-env.d.ts
coverage/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDE / 编辑器 / OS ----
.vscode/
.idea/
.fleet/
.history/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- AI 开发工具与代理配置目录（不上传，避免内部状态/prompt 泄漏）----
.zcode/
.omx/
.agents/
.codex/
.claude/
.cursor/
.gemini/
.aider*
.continue/
.windsurf/
manifest.json
prompts/

# ---- 密钥与环境变量（绝不入库）----
# .env 系列：本地配置含真实 API Key，只有 .env.example / .env.*.example 是模板可入库
.env
.env.*
.envrc
.direnv/
# 允许 example 模板入库（! 取反）
!.env.example
!.env.*.example
# 密钥文件
*.key
*.pem
*.cred
*cred.json
*.p12
*.pfx
# SSH / GPG
.ssh/
.gnupg/

# ---- 包管理器本地配置（开发软件配置，不上传）----
.npmrc
.pnpmrc

# ---- 运行时数据（不入库，运行时生成）----
# runs/ 与 artifacts/ 锚定到 data/ 下，避免误伤 apps/studio/app/runs/ 路由目录
data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
alembic_versions_local/

# ---- 文档（不入库，避免内部设计文档和开发状态泄漏）----
# 所有 docs/ 下的文档仅本地维护，不纳入版本控制。
# 面向用户的说明统一放项目根目录 README.md。
docs/

# ---- 模型与素材（不入库，体积大且含可识别信息）----
models/
*.ckpt
*.gguf
*.onnx
*.pt
*.pth
*.safetensors
assets/*/ref.*
personas/*/voice/ref.wav
personas/*/avatar/portrait.png
personas/*/avatar/idle.mp4
!templates/persona-package/voice/.gitkeep
!templates/persona-package/avatar/.gitkeep

# ---- 构建产物 / 打包 ----
*.zip
*.7z
*.tar
*.tar.gz
*.tar.bz2
*.tgz
avatarloom-v*/

# ---- 调试 / 临时 / 缓存 ----
*.log
*.tmp
*.bak
*.pid
*.pid.lock
.cache/
tmp/
temp/
vendor/
